self="$(dirname "$(readlink --canonicalize "$0")")"

bump_system() {
  (
    # shellcheck disable=SC1091
    source "$self/bump-system.sh"
    bump "$self/../.." "$@"
    git add .
    git diff --cached --quiet || git commit --message "bump system" || return
  )
}

bump_pkgs() {
  (
    # shellcheck disable=SC1091
    source "$self/bump-pkgs.sh"
    cd "$self/.." || return
    trap 'rm --force "result"' EXIT
    bump "$@" || return
    cd "-" || return
    git add .
    git diff --cached --quiet || git commit --message "bump pkgs" || return
  )
}

target="${1:-all}"
shift

# shellcheck disable=SC1091
source "$self/init.sh"
git stash push --include-untracked --message "glitch__olimpik-bump"
trap 'git stash pop --index' EXIT

case "$target" in
"system")
  bump_system "$@" || exit
  ;;
"pkgs")
  bump_pkgs "$@" || exit
  ;;
"all")
  bump_system || exit
  bump_pkgs || exit
  ;;
*)
  echo "unknown target!" >&2
  exit 1
  ;;
esac
