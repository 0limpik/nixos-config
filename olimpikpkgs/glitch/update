self="$(dirname "$(readlink --canonicalize "$0")")"

update_system() {
  (
    # shellcheck disable=SC1091
    source "$self/update-system.sh"
    update "$self/../.." "$@"
    git add .
    git commit --message "update system"
  )
}

update_pkgs() {
  (
    # shellcheck disable=SC1091
    source "$self/update-pkgs.sh"
    cd "$self/.." || return
    trap 'rm --force "result"' EXIT
    update "$@" || return
    cd "-" || return
    git add .
    git commit --message "update pkgs"
  )
}

target="${1:-all}"
shift

# shellcheck disable=SC1091
source "$self/init.sh"
git stash push --include-untracked --message "glitch__olimpik-sync"
trap 'git stash pop --index' EXIT

case "$target" in
"system")
  update_system "$@" || exit
  ;;
"pkgs")
  update_pkgs "$@" || exit
  ;;
"all")
  update_system || exit
  update_pkgs || exit
  ;;
*)
  echo "unknown target!" >&2
  exit 1
  ;;
esac
