update_pkgs() {
  declare -A update

  for key in "packages:4" "vscode_extensions:8"; do
    update[$key]=0
  done

  while [[ $# -gt 0 ]]; do
    known=0
    for key in "${!update[@]}"; do
      user_key="${1//-/_}"
      if [[ $user_key == "${key%:*}" ]]; then
        update[$key]=1
        shift 1
        known=1
      fi
    done
    if [[ $known == 0 ]]; then
      echo "unknown key! $1" >&2
      exit 1
    fi
  done

  all=1
  for value in "${update[@]}"; do
    if [[ $value == 1 ]]; then
      all=0
      break
    fi
  done
  if [[ $all == 1 ]]; then
    for key in "${!update[@]}"; do
      update[$key]=1
    done
  fi

  for key in "${!update[@]}"; do
    value="${update[$key]}"
    if [[ $value == 0 ]]; then
      continue
    fi

    update_scope || return
  done
}

target="${1:all}"
shift

case "$target" in
"pkgs")
  update_pkgs "$@" || exit
  ;;
"all")
  update_pkgs || exit
  ;;
*)
  echo "unknown target!" >&2
  exit 1
  ;;
esac
