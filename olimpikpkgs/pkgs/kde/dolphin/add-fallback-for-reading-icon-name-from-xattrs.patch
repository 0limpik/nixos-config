-        QString iconName = fileItem.iconName();
-        if (!QIcon::hasThemeIcon(iconName)) {
-            QMimeDatabase mimeDb;
-            iconName = mimeDb.mimeTypeForName(fileItem.mimetype()).genericIconName();
+        QString iconName;
+        const QUrl url = fileItem.url();
+        const auto props = std::make_unique<ViewProperties>(url);
+        QTextStream out(stdout);
+        //out << "url:2 " << url.toString() << Qt::endl;
+        const QByteArray icon = props->icon();
+        iconName = QString::fromLatin1(icon);
+        if (iconName.isEmpty()) {
+            iconName = fileItem.iconName();
+            if (!QIcon::hasThemeIcon(iconName)) {
+                QMimeDatabase mimeDb;
+                iconName = mimeDb.mimeTypeForName(fileItem.mimetype()).genericIconName();
+            }
         }
+        //out << "icon:2 " << iconName << Qt::endl;
         data.insert("iconName", iconName);
         item->setData(data, {"iconName"});
     }
