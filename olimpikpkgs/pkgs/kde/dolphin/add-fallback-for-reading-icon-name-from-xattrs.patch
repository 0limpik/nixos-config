@@ -37,8 +38,32 @@ const char ViewPropertiesFileName[] = ".directory";
 
 ViewPropertySettings *ViewProperties::loadProperties(const QString &folderPath) const
 {
+    QTextStream out(stdout);
     const QString settingsFile = folderPath + QDir::separator() + ViewPropertiesFileName;
+    ViewPropertySettings* props = loadPropertiesInternal(folderPath, settingsFile);
+    if (props) {
+        out << "file: " << settingsFile << Qt::endl;
+        return props;
+    }
+    QString fallbackFolderPath;
+    QString fallbackSettingsFile;
+    const QString appDataLocation = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    if (!folderPath.startsWith(appDataLocation)) {
+        fallbackFolderPath = destinationDir(QStringLiteral("local")) + folderPath;
+        fallbackSettingsFile = fallbackFolderPath + QDir::separator() + ViewPropertiesFileName;
+        props = loadPropertiesInternal(fallbackFolderPath, fallbackSettingsFile);
+        if (props) {
+            out << "fallback: " << fallbackSettingsFile << Qt::endl;
+            return props;
+        }
+    }
+    out << "fail:\n" << folderPath << ":" << settingsFile << "\n" << fallbackFolderPath << ":" << fallbackSettingsFile << Qt::endl;
+    return props;
+}
 
+ViewPropertySettings *ViewProperties::loadPropertiesInternal(const QString &folderPath, const QString &settingsFile) const
+{
+    QTextStream out(stdout);
     std::shared_ptr<QFile> file = std::make_shared<QFile>(settingsFile);
     if (file->exists()) {
         if (!file->open(QIODevice::ReadOnly)) {
@@ -50,6 +75,7 @@ ViewPropertySettings *ViewProperties::loadProperties(const QString &folderPath)
     KFileMetaData::UserMetaData metadata(folderPath);
     if (!metadata.isSupported()) {
